#: ../../source/3.1SDK_Connection.md
msgid "`WebSocket`"
msgstr "`WebSocket`"

#: ../../source/3.1SDK_Connection.md
msgid "WebSocket protocol (default)"
msgstr "WebSocket 协议（默认）"

#: ../../source/3.1SDK_Connection.md
msgid "`Udp`"
